APP_NAME=CheckMyCode
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=checkmycode
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NativePHP / GitHub Releases Auto-Update
NATIVEPHP_APP_VERSION=1.1.0
NATIVEPHP_UPDATER_PROVIDER=github
GITHUB_OWNER=aliuwahab
GITHUB_REPO=mysafecoding-desktop
GITHUB_TOKEN=
GITHUB_RELEASE_TYPE=draft

# ── CheckMyCode ────────────────────────────────────────────────────────────
# desktop = NativePHP app (default) · web = hosted, anonymous, nothing stored
CHECKMYCODE_MODE=desktop
# Set false for fully offline scans (skips endoflife.date lookups)
CHECKMYCODE_ENDOFLIFE_ENABLED=true
# Web mode limits (also needs QUEUE_CONNECTION=database and a running queue:work)
CHECKMYCODE_WEB_MAX_UPLOAD_MB=50
CHECKMYCODE_WEB_MAX_FILES=20000
CHECKMYCODE_WEB_RESULTS_TTL_MINUTES=60
CHECKMYCODE_WEB_SCANS_PER_HOUR=10
# CHECKMYCODE_WEB_WORKSPACE=/tmp/checkmycode-web-scans
# CHECKMYCODE_TRIVY_BINARY=trivy
# CHECKMYCODE_SEMGREP_BINARY=semgrep
# CHECKMYCODE_GITLEAKS_BINARY=gitleaks
# Open-source links shown in the sidebar
# CHECKMYCODE_GITHUB_URL=https://github.com/aliuwahab/mysafecoding-desktop
# CHECKMYCODE_SPONSOR_URL=https://github.com/sponsors/aliuwahab
